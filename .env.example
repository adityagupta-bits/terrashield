# Backend Database (PostgreSQL + PostGIS in Docker / production)
# Example: postgresql://postgres:terrashield_secure_pwd@localhost:5432/terrashield
# For zero-dependency local dev without Docker, fallback to SQLite:
DATABASE_URL=sqlite:///./terrashield.db

# JWT Authentication
JWT_SECRET=terrashield_super_secure_jwt_token_secret_key_2026_sih
JWT_EXPIRE_MINUTES=1440

# Demo & Security Settings
DEMO_MODE=true
CORS_ORIGINS=*

# WhatsApp Provider Configuration (mock, twilio, or meta)
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=mock_sid
TWILIO_AUTH_TOKEN=mock_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
META_WHATSAPP_TOKEN=mock_meta_token
META_PHONE_NUMBER_ID=mock_phone_id

# Weather & Region Defaults
DEFAULT_LAT=30.0869
DEFAULT_LNG=78.2676
DEFAULT_REGION_NAME="Rishikesh-Garhwal Catchment"

