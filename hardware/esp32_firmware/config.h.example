#ifndef CONFIG_H
#define CONFIG_H

// ================= TERRA SHIELD HARDWARE CONFIGURATION =================
// Copy this file to config.h and customize for your ESP32 node.

// Node Identity
#define NODE_ID "PHY-01"
#define IS_GATEWAY true

// Ingest Authentication (Physical Node SHA-256 Key)
// Use the key generated by backend/scripts/seed.py
#define NODE_API_KEY "ts_live_phy-01_64f88c22889172f1b5b5fba7"

// Backend Server Endpoint
#define BACKEND_SERVER_URL "http://192.168.1.100:8000"
#define INGEST_READING_PATH "/api/v1/ingest/reading"
#define INGEST_BATCH_PATH "/api/v1/ingest/store-forward"
#define INGEST_ALERT_PATH "/api/v1/ingest/alert"

// WiFi Credentials (for Gateway or Direct Ingest Nodes)
#define WIFI_SSID "TERRA_SHIELD_GW"
#define WIFI_PASS "ResilientMesh2026"

// Hardware Pin Mappings (ESP32 NodeMCU)
#define PIN_TRIG 5          // Ultrasonic HC-SR04 Trigger
#define PIN_ECHO 18         // Ultrasonic HC-SR04 Echo
#define PIN_DHT 4           // DHT22 Ambient Sensor
#define PIN_MQ135 34        // MQ-135 Gas / Smoke Analog (ADC1)
#define PIN_BATTERY 35      // Battery Voltage Divider (ADC1)
#define PIN_LED_MESH 2      // Blue LED: Mesh activity
#define PIN_SIREN_ALERT 19  // Red LED / Active Piezo Buzzer: On-device Alert

// Thresholds
#define SURGE_DELTA_THRESHOLD_M 0.40f  // Rapid rate of change (m)
#define WATER_CRITICAL_LEVEL_M 4.00f   // Absolute flood depth (m)
#define BUFFER_MAX_RECORDS 200         // LittleFS max stored records before FIFO rollover

#endif // CONFIG_H
